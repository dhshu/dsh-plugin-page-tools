{
  "name": "dsh-plugin-page-tools",
  "version": "0.3.1",
  "description": "Search, pagination and one-click update-all for the installed plugin list. · 插件列表增强：搜索已安装插件、可调每页条数，并在检查更新后一键全部更新。",
  "type": "module",
  "main": "./lib/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhshu/dsh-plugin-page-tools.git"
  },
  "homepage": "https://github.com/dhshu/dsh-plugin-page-tools#readme",
  "bugs": {
    "url": "https://github.com/dhshu/dsh-plugin-page-tools/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "plugin-manager",
    "search",
    "pagination"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [],
      "external": [
        "@deepseek-ai/dsh-client-ui-plugin-manager/client"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.2.2-rc.5 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-plugin-manager": {
      "optional": true
    }
  }
}
